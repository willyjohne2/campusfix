# Copy this file to .env and fill with real secrets for local development
DJANGO_SECRET_KEY=replace-me-with-a-secret
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=CampusFix <onboarding@example.com>
# Add SMTP credentials below if using SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Email Configuration (Gmail SMTP with App Password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=CampusFix <your@gmail.com>

# Debug Mode
DEBUG=True

# Secret Key (for production, use a secure key generator)
SECRET_KEY=your-secret-key-here
